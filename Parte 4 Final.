import pandas as pd


# ==========================================
# CARGA DE DATOS
# ==========================================

juegos = pd.read_csv("rolbot_juegos_200.csv")


# ==========================================
# CLASE GRAFO DE JUEGOS RELACIONADOS
# ==========================================

class GrafoJuegos:

    def __init__(self):
        self.adjacencia = {}

    def agregar_juego(self, juego):
        if juego not in self.adjacencia:
            self.adjacencia[juego] = set()

    def agregar_relacion(self, juego1, juego2):
        self.agregar_juego(juego1)
        self.agregar_juego(juego2)

        if juego1 != juego2:
            self.adjacencia[juego1].add(juego2)
            self.adjacencia[juego2].add(juego1)

    def obtener_relacionados(self, juego):
        nombre_buscado = juego.strip().casefold()

        for nodo in self.adjacencia:
            if nodo.casefold() == nombre_buscado:
                return sorted(self.adjacencia[nodo])

        return []


# ==========================================
# CONSTRUCCIÓN Y POBLADO DEL GRAFO
# ==========================================

def construir_grafo_juegos(df):

    grafo = GrafoJuegos()
    lista_juegos = df.to_dict("records")

    for i in range(len(lista_juegos)):

        j1 = lista_juegos[i]
        nombre1 = str(j1["juego"])

        grafo.agregar_juego(nombre1)

        for j in range(i + 1, len(lista_juegos)):

            j2 = lista_juegos[j]
            nombre2 = str(j2["juego"])

            # Comparamos los géneros
            mismo_genero = (
                str(j1["genero"]).casefold()
                == str(j2["genero"]).casefold()
            )

            # Comparamos los sistemas
            mismo_sistema = (
                str(j1["sistema"]).casefold()
                == str(j2["sistema"]).casefold()
            )

            # Creamos la relación si comparten género o sistema
            if mismo_genero or mismo_sistema:
                grafo.agregar_relacion(nombre1, nombre2)

    return grafo


# Creamos el grafo con los datos del CSV
grafo_rolbot = construir_grafo_juegos(juegos)


# ==========================================
# FUNCIÓN 1: BUSCAR JUEGOS RELACIONADOS
# ==========================================

def buscar_relacionados_por_grafo():

    nombre = input(
        "\nIngrese el nombre del juego para buscar relacionados: "
    ).strip()

    # Comprobamos que el juego exista
    juego_encontrado = None

    for nodo in grafo_rolbot.adjacencia:
        if nodo.casefold() == nombre.casefold():
            juego_encontrado = nodo
            break

    if juego_encontrado is None:
        print(f"\nEl juego '{nombre}' no existe en la base de datos.")
        return

    relacionados = grafo_rolbot.obtener_relacionados(juego_encontrado)

    if relacionados:
        print(f"\nJuegos relacionados con '{juego_encontrado}':")

        for idx, rel in enumerate(relacionados[:10], start=1):
            print(f"{idx}. {rel}")

        if len(relacionados) > 10:
            print(f"... y {len(relacionados) - 10} juegos más.")

    else:
        print("\nNo se encontraron juegos relacionados.")


# ==========================================
# FUNCIÓN 2: RECOMENDACIÓN PERSONALIZADA
# ==========================================

def recomendar_por_dificultad_y_duracion():

    print("\n--- RECOMENDACIÓN PERSONALIZADA ---")

    dificultad = input(
        "Ingrese la dificultad (ej. Baja, Media, Alta): "
    ).strip()

    print("\nDuraciones disponibles:")
    for duracion_disponible in sorted(
        juegos["duracion"].dropna().astype(str).unique()
    ):
        print("-", duracion_disponible)

    duracion = input(
        "\nIngrese la duración exacta: "
    ).strip()

    filtro_dificultad = (
        juegos["dificultad"].astype(str).str.casefold()
        == dificultad.casefold()
    )

    filtro_duracion = (
        juegos["duracion"].astype(str).str.casefold()
        == duracion.casefold()
    )

    resultado = juegos[filtro_dificultad & filtro_duracion]

    if resultado.empty:
        print("\nNo se encontraron juegos con esos criterios exactos.")

    else:
        print(f"\nSe encontraron {len(resultado)} juegos recomendados:")

        print(
            resultado[
                [
                    "juego",
                    "genero",
                    "dificultad",
                    "duracion",
                    "popularidad"
                ]
            ].to_string(index=False)
        )


# ==========================================
# MENÚ INTERACTIVO DE LA PARTE 4
# ==========================================

def modulo_parte_4():

    while True:

        print("""
========================================
       ROLBOT - PARTE 4
========================================
1. Ver juegos relacionados (Grafo)
2. Recomendación por dificultad y duración
0. Volver / Salir
----------------------------------------
""")

        opcion = input("Opción: ").strip()

        if opcion == "1":
            buscar_relacionados_por_grafo()

        elif opcion == "2":
            recomendar_por_dificultad_y_duracion()

        elif opcion == "0":
            print("Saliendo del módulo Parte 4.")
            break

        else:
            print("Opción inválida. Intente nuevamente.")


# ==========================================
# INICIO DEL PROGRAMA
# ==========================================

if __name__ == "__main__":
    modulo_parte_4()
