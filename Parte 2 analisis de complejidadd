# ==========================================
# EXPERIMENTO DE COMPLEJIDAD
# ==========================================

def realizar_experimento(cantidad):

    datos = [
        f"Juego {i}"
        for i in range(cantidad)
    ]

    arbol = ArbolBusqueda()

    cargar_arbol_balanceado(
        arbol,
        datos
    )

    juego_buscado = f"Juego {cantidad - 1}"


    # Búsqueda secuencial

    inicio = time.perf_counter()

    resultado_secuencial, comparaciones_secuencial = (
        busqueda_secuencial(
            juego_buscado,
            datos
        )
    )

    fin = time.perf_counter()

    tiempo_secuencial = (fin - inicio) * 1000


    # Búsqueda en árbol

    inicio = time.perf_counter()

    resultado_arbol, comparaciones_arbol = (
        arbol.buscar(
            juego_buscado
        )
    )

    fin = time.perf_counter()

    tiempo_arbol = (fin - inicio) * 1000


    return (
        cantidad,
        comparaciones_secuencial,
        comparaciones_arbol,
        tiempo_secuencial,
        tiempo_arbol
    )


